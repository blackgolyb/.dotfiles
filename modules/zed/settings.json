// Zed settings
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    "context_servers": {
        "shadcn-mcp-server": {
            "enabled": false,
            "settings": {},
        },
        "mcp-server-github": {
            "enabled": false,
            "settings": {},
        },
        "mcp-server-context7": {
            "enabled": false,
            "settings": {},
        },
    },
    "tab_bar": {
        "show": false,
        "show_nav_history_buttons": false,
    },
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": false,
        "selections_menu": false,
    },
    "terminal": {
        "button": false,
        "font_size": 20,
        "font_family": "JetBrainsMono Nerd Font",
        "line_height": {
            "custom": 1.3,
        },
    },
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "claude-sonnet-4.5",
        },
        "model_parameters": [],
        "sidebar_side": "right",
    },
    "edit_predictions": {
        "mode": "eager", // or "subtle"
    },
    "collaboration_panel": {
        "button": false,
    },
    "outline_panel": {
        "button": false,
    },
    "project_panel": {
        "auto_fold_dirs": false,
        "sticky_scroll": false,
        "button": false,
        "dock": "right",
    },
    "gutter": {
        // штука там де номера ліній
        "folds": false,
        "runnables": false,
        "breakpoints": false,
    },
    "centered_layout": {
        "left_padding": 0.1,
        "right_padding": 0.1,
    },
    "show_edit_predictions": true,
    "features": {
        "edit_prediction_provider": "copilot",
    },
    "vim_mode": true,
    "vim": {
        "use_smartcase_find": false,
    },
    "command_aliases": {
        "W": "w",
        "Wq": "wq",
        "Q": "q",
        "we": "save without format",
        "We": "save without format",
    },
    "relative_line_numbers": "enabled",
    "tab_size": 4,
    "inlay_hints": {
        "enabled": false,
        "show_background": true,
    },
    "title_bar": {
        // "show": false,
    },
    "status_bar": {
        // "experimental.show": false,
    },
    "preferred_line_length": 80,
    "vertical_scroll_margin": 10,
    "ui_font_size": 16,
    "buffer_font_size": 18,
    "buffer_font_family": "FiraCode Nerd Font Mono",
    "theme": "Mono Dark",
    "file_types": {
        "Clojure": ["yuck"],
    },
    "languages": {
        "JSON": {
            "tab_size": 2,
        },
        "Python": {
            "language_servers": ["pyright", "ruff"],
            // "language_servers": ["pyright"],
            "format_on_save": "on",
            "code_actions_on_format": {
                "source.organizeImports.ruff": true,
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "ruff",
                    },
                },
            ],
        },
        "JavaScript": {
            "formatter": {
                "external": {
                    "command": "npx",
                    "arguments": [
                        "prettier",
                        "--ignore-unknown",
                        "--stdin-filepath",
                        "{buffer_path}",
                    ],
                },
            },
        },
        "TypeScript": {
            "formatter": {
                "external": {
                    "command": "npx",
                    "arguments": [
                        "prettier",
                        "--ignore-unknown",
                        "--stdin-filepath",
                        "{buffer_path}",
                    ],
                },
            },
        },
        "Markdown": {
            "format_on_save": "on",
            "remove_trailing_whitespace_on_save": false,
        },
    },
    "lsp": {
        "typos": {
            "initialization_options": {
                // Diagnostic severity within Zed. "Error" by default, can be:
                // "Error", "Hint", "Information", "Warning"
                "diagnosticSeverity": "Warning",
            },
        },
        "ruff": {
            "initialization_options": {
                "settings": {
                    // Ruff server settings goes here
                    "lineLength": 100,
                    "lint": {
                        "extendSelect": ["I"],
                    },
                },
            },
        },
        "pyright": {
            "settings": {
                "python.analysis": {
                    "typeCheckingMode": "off",
                },
                "python": {
                    "pythonPath": ".venv/bin/python",
                },
            },
        },
        "tailwindcss-language-server": {
            "settings": {
                "classAttributes": ["class", "className", "ngClass", "styles"],
            },
        },
        "texlab": {
            "settings": {
                "texlab": {
                    "build": {
                        "onSave": false,
                    },
                },
            },
        },
    },
}
